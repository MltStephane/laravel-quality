# Base PHPStan parameters shared by every project.
# Larastan and deprecation rules are included by the project's phpstan.neon.dist
# (relative includes would break when this package is installed as a symlink).
parameters:
    level: 6
    reportUnmatchedIgnoredErrors: true
    reportIgnoresWithoutComments: true
    # Read the casts declared in Model::casts() (dates, enums, custom casts), not only its return type.
    parseModelCastsMethod: true
    # Each rule can be turned on or off. Lists merge with the project's values:
    # write `presentationNamespaces!: [...]` to replace them.
    laravelQuality:
        noModelWriteInPresentation: true
        # Opt-in: reading models in render() is common Livewire practice (see README).
        noQueryInPresentation: false
        noStringRole: true
        noBroadCatchWithoutRethrow: true
        # Opt-in: identifiers bound by wire:model are false positives PHPStan cannot see (see README).
        missingLockedIdProperty: false
        presentationNamespaces:
            - App\Livewire
            - App\Http
            - App\NativeComponents

parametersSchema:
    laravelQuality: structure([
        noModelWriteInPresentation: bool(),
        noQueryInPresentation: bool(),
        noStringRole: bool(),
        noBroadCatchWithoutRethrow: bool(),
        missingLockedIdProperty: bool(),
        presentationNamespaces: listOf(string()),
    ])

conditionalTags:
    MltStephane\LaravelQuality\PHPStan\Rules\NoModelWriteInPresentationRule:
        phpstan.rules.rule: %laravelQuality.noModelWriteInPresentation%
    MltStephane\LaravelQuality\PHPStan\Rules\NoQueryInPresentationRule:
        phpstan.rules.rule: %laravelQuality.noQueryInPresentation%
    MltStephane\LaravelQuality\PHPStan\Rules\NoStringRoleRule:
        phpstan.rules.rule: %laravelQuality.noStringRole%
    MltStephane\LaravelQuality\PHPStan\Rules\NoBroadCatchWithoutRethrowRule:
        phpstan.rules.rule: %laravelQuality.noBroadCatchWithoutRethrow%
    MltStephane\LaravelQuality\PHPStan\Rules\MissingLockedIdPropertyRule:
        phpstan.rules.rule: %laravelQuality.missingLockedIdProperty%

services:
    -
        class: MltStephane\LaravelQuality\PHPStan\Rules\NoModelWriteInPresentationRule
        arguments:
            presentationNamespaces: %laravelQuality.presentationNamespaces%
    -
        class: MltStephane\LaravelQuality\PHPStan\Rules\NoQueryInPresentationRule
        arguments:
            presentationNamespaces: %laravelQuality.presentationNamespaces%
    - MltStephane\LaravelQuality\PHPStan\Rules\NoStringRoleRule
    - MltStephane\LaravelQuality\PHPStan\Rules\NoBroadCatchWithoutRethrowRule
    - MltStephane\LaravelQuality\PHPStan\Rules\MissingLockedIdPropertyRule
