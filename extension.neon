# Base PHPStan parameters shared by every project.
# Larastan and deprecation rules are included by the project's phpstan.neon.dist
# (relative includes would break when this package is installed as a symlink).
parameters:
    level: 6
    reportUnmatchedIgnoredErrors: true
    reportIgnoresWithoutComments: true
    # Read the casts declared in Model::casts() (dates, enums, custom casts), not only its return type.
    parseModelCastsMethod: true
